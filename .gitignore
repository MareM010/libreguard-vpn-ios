# macOS
.DS_Store

# Xcode per-user state and local build products
**/xcuserdata/
*.xcuserstate
DerivedData/
build/
*.xcresult/
*.xcarchive/

# Swift Package Manager local state
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# Local signing material; never commit signing keys or provisioning profiles
*.mobileprovision
*.p12
*.p8

# Local-only credentials/configuration files
.env
.env.*
!.env.example
*.local.xcconfig

# Local diagnostics
*.log

# Local release assessments, policy drafts and review evidence
/.local/
/APP_STORE_*READINESS*.md
/APP_STORE_POLICY_DRAFTS.md
/APP_STORE_SOURCE_HISTORY_REVIEW.md

# Rebuild from the checksum-pinned source before resolving Swift packages.
Vendor/OpenSSL/openssl.xcframework/
Vendor/OpenSSL/build-provenance.json
